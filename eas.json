{
  "cli": {
    "version": ">= 15.0.12",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "image": "latest"
      },
      "ios": {
        "image": "latest"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "adtest": {
      "distribution": "internal",
      "channel": "adtest",
      "env": {
        "APP_VARIANT": "adtest"
      }
    },
    "personal": {
      "distribution": "internal",
      "channel": "personal",
      "env": {
        "APP_VARIANT": "personal"
      }
    },
    "closedtest": {
      "extends": "production",
      "channel": "closedtest",
      "env": {
        "EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID": "ca-app-pub-3940256099942544/6300978111",
        "EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID": "ca-app-pub-3940256099942544/1033173712"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "ADMOB_ANDROID_APP_ID": "ca-app-pub-5450869285052283~6244227069",
        "EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID": "ca-app-pub-5450869285052283/4312198299"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
