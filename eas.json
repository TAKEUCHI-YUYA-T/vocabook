{
  "cli": {
    "version": ">= 15.0.12",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "image": "latest"
      },
      "ios": {
        "image": "latest"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "personal": {
      "distribution": "internal",
      "channel": "personal",
      "env": {
        "APP_VARIANT": "personal"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "ADMOB_ANDROID_APP_ID": "ca-app-pub-5450869285052283~6244227069",
        "EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID": "ca-app-pub-5450869285052283/4312198299"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
